# Copy to .env (never commit). Loaded via `node --env-file=.env`.
PORT=3000
# Public base URL encoded inside pass QR codes (https in production).
BASE_URL=http://localhost:3000
# Long random string. Used to derive QR tokens, so changing it invalidates issued passes.
SERVER_SECRET=change-me-to-a-long-random-string
DATA_DIR=./data
# Set to 1 when running behind a reverse proxy / load balancer that terminates TLS.
TRUST_PROXY=0
# Used only by `npm run seed` when creating the first Super Admin.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
